// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// Note: User authentication is handled entirely by Clerk.
// We don't duplicate user data - use auth() to get userId and currentUser() for full user info.
// All models reference users directly by their Clerk ID.

// Project model - represents user projects
model Project {
    id            String    @id @default(cuid())
    name          String
    fileStructure Json?
    clerkUserId   String    // References Clerk's user ID directly
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Relations
    files              File[]
    sandboxes          Sandbox[]
    aiGenerations      AIGeneration[]
    githubExports      GitHubExport[]
    netlifyDeployments NetlifyDeployment[]

    @@index([clerkUserId])
}

// File model - represents files in projects
model File {
    id        String   @id @default(cuid())
    path      String
    content   String   @db.Text
    language  String?
    projectId String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, path])
    @@index([projectId])
}

// AIGeneration model - tracks AI-generated content
model AIGeneration {
    id          String   @id @default(cuid())
    prompt      String   @db.Text
    response    String   @db.Text
    tokens      Int?
    duration    Int?
    model       String?  // Claude model used (haiku, sonnet, etc.)
    clerkUserId String   // References Clerk's user ID directly
    projectId   String?
    sessionId   String?  // Claude session ID for resumption
    sessionData String?  @db.Text // Claude session .jsonl file content for resumption
    totalCost   Float?   // Cost in USD
    createdAt   DateTime @default(now())

    // Relations
    project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

    @@index([clerkUserId])
    @@index([projectId])
    @@index([sessionId])
}

// Sandbox status enum for type safety
enum SandboxStatus {
    ACTIVE
    STOPPED
    ERROR
}

// User plan enum for subscription tiers
enum UserPlan {
    FREE
    BUILDER
    PRO
}

// Sandbox model - tracks E2B sandbox environments
model Sandbox {
    id           String        @id @default(cuid())
    e2bId        String        @unique
    status       SandboxStatus @default(ACTIVE)
    projectId    String?       // Optional for Phase 4 pooled sandboxes
    previewUrl   String?       // Live preview URL (for Phase 3)
    templateId   String?       // E2B template identifier
    lastActivity DateTime      @default(now()) // Track activity for cleanup
    expiresAt    DateTime?     // Sandbox expiration timestamp
    metadata     Json?         // Store E2B metadata (projectId, userId, pool info)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    // Relations
    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([status])
    @@index([expiresAt])
}

// UserUsage model - tracks user subscription and usage limits
model UserUsage {
    id                   String   @id @default(cuid())
    clerkUserId          String   @unique // References Clerk's user ID directly
    plan                 UserPlan @default(FREE)

    // Billing period tracking
    currentPeriodStart   DateTime @default(now())
    currentPeriodEnd     DateTime

    // Usage tracking
    generationsThisMonth Int      @default(0)
    lastGenerationAt     DateTime?

    // Metadata
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    @@index([clerkUserId])
    @@index([currentPeriodEnd])
}

// Feedback type enum - categorizes user feedback
enum FeedbackType {
    BUG_REPORT
    FEATURE_REQUEST
    GENERAL_FEEDBACK
    SUPPORT_REQUEST
}

// Feedback status enum - tracks feedback state
enum FeedbackStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
}

// Feedback model - stores user feedback, bug reports, and support requests
model Feedback {
    id          String         @id @default(cuid())
    clerkUserId String         // References Clerk's user ID directly
    type        FeedbackType
    message     String         @db.Text
    metadata    Json?          // Auto-captured context (URL, project, browser, etc.)
    status      FeedbackStatus @default(OPEN)
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt

    @@index([clerkUserId])
    @@index([status])
    @@index([type])
    @@index([createdAt(sort: Desc)])
}

// GitHub connection tracking
model GitHubConnection {
    id                String   @id @default(cuid())
    clerkUserId       String   @unique // One GitHub connection per user

    // GitHub User Info (cached for display)
    githubUsername    String
    githubUserId      String // GitHub's user ID

    // GitHub OAuth token (encrypted, for API access)
    // Stored here instead of Clerk since we're using custom OAuth flow
    accessToken       String   @db.Text

    // Connection metadata
    connectedAt       DateTime @default(now())
    lastSyncAt        DateTime?

    // Preferences
    defaultBranch     String   @default("main")

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    // Relations
    exports           GitHubExport[]

    @@index([clerkUserId])
    @@index([githubUserId])
}

// Export history tracking
model GitHubExport {
    id           String       @id @default(cuid())
    projectId    String
    connectionId String

    // Repository Info
    repoOwner    String // GitHub username
    repoName     String
    repoFullName String // "owner/repo"
    repoUrl      String // Full GitHub URL
    branch       String       @default("main")

    // Export Metadata
    commitSha    String?      // Last commit SHA
    commitMessage String      @db.Text
    filesExported Int         @default(0)
    status       ExportStatus @default(PENDING)
    errorMessage String?      @db.Text

    // Timing
    startedAt    DateTime     @default(now())
    completedAt  DateTime?

    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    // Relations
    project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    connection   GitHubConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([connectionId])
    @@index([status])
    @@index([createdAt(sort: Desc)])
}

enum ExportStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    FAILED
}

// OAuth state storage for CSRF protection
// Replaces in-memory Map to support serverless/multi-instance deployments
model OAuthState {
    id        String   @id @default(cuid())
    nonce     String   @unique // Random nonce for state token
    userId    String   // Clerk user ID
    returnUrl String   // Validated return URL
    expiresAt DateTime // State expiration (10 minutes)
    createdAt DateTime @default(now())

    @@index([nonce])
    @@index([expiresAt])
    @@index([userId])
}

// ============================================================================
// NETLIFY INTEGRATION MODELS
// ============================================================================

// Netlify OAuth connection (one per user)
model NetlifyConnection {
    id              String              @id @default(cuid())
    clerkUserId     String              @unique

    // Netlify user info
    netlifyEmail    String
    netlifyUserId   String
    netlifyFullName String?

    // OAuth token (encrypted at rest via Prisma)
    accessToken     String              @db.Text

    // Timestamps
    connectedAt     DateTime            @default(now())
    lastDeployAt    DateTime?
    createdAt       DateTime            @default(now())
    updatedAt       DateTime            @updatedAt

    // Relations
    deployments     NetlifyDeployment[]

    @@index([clerkUserId])
    @@index([netlifyUserId])
}

// Netlify deployment history
model NetlifyDeployment {
    id            String           @id @default(cuid())
    projectId     String
    connectionId  String

    // Site info
    siteId        String
    siteName      String
    siteUrl       String
    deployUrl     String?
    deployId      String?
    adminUrl      String? // Netlify dashboard URL for site management

    // Build metadata
    buildSize     Int?
    filesDeployed Int              @default(0)
    buildTime     Int?

    // Status tracking
    status        DeploymentStatus @default(PENDING)
    errorMessage  String?          @db.Text

    // Timestamps
    startedAt     DateTime         @default(now())
    completedAt   DateTime?
    createdAt     DateTime         @default(now())
    updatedAt     DateTime         @updatedAt

    // Relations
    project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
    connection    NetlifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([connectionId])
    @@index([status])
}

enum DeploymentStatus {
    PENDING
    BUILDING
    DEPLOYING
    COMPLETED
    FAILED
}
