# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# For local development: postgresql://postgres:password@localhost:5432/stryama
# For production: Use your hosted database URL (e.g., Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stryama"

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================
# Clerk secret key for server-side authentication
# Obtain from: https://dashboard.clerk.com/ -> API Keys
# Format: sk_test_... (test) or sk_live_... (production)
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk publishable key for client-side authentication
# Obtain from: https://dashboard.clerk.com/ -> API Keys
# Format: pk_test_... (test) or pk_live_... (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk authentication routes
# These paths point to your sign-in/sign-up pages and redirect URLs after authentication
# IMPORTANT: Set AFTER URLs to /dashboard to enable landing page prompt auto-creation flow
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================================
# ADMIN ACCESS
# =============================================================================
# Comma-separated list of Clerk user IDs with admin access
# Admin users can access /admin/feedback to view and manage user feedback
# Obtain user IDs from: https://dashboard.clerk.com/ -> Users -> Select user -> Copy User ID
# Format: user_xxxxxxxxxxxxxxxxxxxxx,user_yyyyyyyyyyyyyyyyyyyyy
# Example: ADMIN_USER_IDS="user_2NNEqL2nrIRdJ194ndJqAHtrx,user_2XYZ789abc"
ADMIN_USER_IDS=""

# =============================================================================
# BETA TESTERS (MVP Launch)
# =============================================================================
# Beta tester allowlist for MVP testing period
# Grant free access to paid plans without requiring a subscription
# Format: user_id1:PLAN,user_id2:PLAN,...
# Plans: FREE | BUILDER | PRO
# Obtain user IDs from: https://dashboard.clerk.com/ -> Users -> Select user -> Copy User ID
# Example: BETA_TESTERS="user_2NNEqL2nrIRdJ194ndJqAHtrx:BUILDER,user_2XYZ789abc:PRO"
# Leave empty or omit if not using beta testers
BETA_TESTERS=""

# =============================================================================
# AI SERVICES
# =============================================================================
# Anthropic API key for Claude AI integration
# Obtain from: https://console.anthropic.com/ -> API Keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# SANDBOX ENVIRONMENT
# =============================================================================
# E2B API key for code execution sandbox
# Obtain from: https://e2b.dev/docs -> API Keys
# Format: e2b_...
E2B_API_KEY="e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# APPLICATION
# =============================================================================
# Public URL of your application
# IMPORTANT: Update this for production deployment for SEO and social sharing
# Local development: http://localhost:3000
# Production: https://stryama.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (automatically set by Next.js, usually don't need to override)
# Options: development | test | production
NODE_ENV=development

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# PostHog analytics configuration
# Obtain from: https://app.posthog.com/ -> Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# =============================================================================
# GITHUB INTEGRATION (Optional)
# =============================================================================
# GitHub OAuth credentials for project export feature
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Application name: Stryama (or your app name)
# - Homepage URL: https://stryama.app (or your production URL)
# - Authorization callback URL: https://stryama.app/api/github/callback
# For local development, also add: http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL: DEVELOPMENT TOOLS
# =============================================================================
# Skip environment validation during build (useful for Docker builds)
# Set to "1" to skip validation
# SKIP_ENV_VALIDATION=""
