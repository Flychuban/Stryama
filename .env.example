# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# For local development: postgresql://postgres:password@localhost:5432/stryama
# For production: Use your hosted database URL (e.g., Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stryama"

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================
# Clerk secret key for server-side authentication
# Obtain from: https://dashboard.clerk.com/ -> API Keys
# Format: sk_test_... (test) or sk_live_... (production)
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk publishable key for client-side authentication
# Obtain from: https://dashboard.clerk.com/ -> API Keys
# Format: pk_test_... (test) or pk_live_... (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk authentication routes
# These paths point to your sign-in/sign-up pages and redirect URLs after authentication
# IMPORTANT: Set AFTER URLs to /dashboard to enable landing page prompt auto-creation flow
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================================
# AI SERVICES
# =============================================================================
# Anthropic API key for Claude AI integration
# Obtain from: https://console.anthropic.com/ -> API Keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# SANDBOX ENVIRONMENT
# =============================================================================
# E2B API key for code execution sandbox
# Obtain from: https://e2b.dev/docs -> API Keys
# Format: e2b_...
E2B_API_KEY="e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# APPLICATION
# =============================================================================
# Public URL of your application
# Local development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (automatically set by Next.js, usually don't need to override)
# Options: development | test | production
NODE_ENV=development

# =============================================================================
# OPTIONAL: DEVELOPMENT TOOLS
# =============================================================================
# Skip environment validation during build (useful for Docker builds)
# Set to "1" to skip validation
# SKIP_ENV_VALIDATION=""
